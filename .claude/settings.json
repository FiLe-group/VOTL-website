{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/typecheck.cjs",
            "timeout": 60,
            "statusMessage": "Type-checking (tsc --noEmit)..."
          }
        ]
      }
    ]
  }
}
